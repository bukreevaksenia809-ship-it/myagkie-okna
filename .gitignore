#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Сборки и локальные артефакты проекта
build/
dist/
.firebase/
firebase-debug.log

# Архивы зафиксированных версий: сами архивы в git не храним, только теги.
# Содержимое versions/ игнорируется целиком, кроме этой справки.
versions/*
!versions/ЧИТАЙ-МЕНЯ.md

# RuStore release signing (never commit)
android/key.properties
android/upload-keystore.jks
*.jks
*.keystore

# Cloudflare Wrangler local state
cloudflare/.wrangler/
